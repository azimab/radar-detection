+    def _numpy_voxelize(points, voxel_size, point_cloud_range, max_points, max_voxels):
+        """Deterministic PointPillar voxelization fallback when spconv is absent."""
+        voxel_size = np.asarray(voxel_size, dtype=np.float32)
+        pc_range = np.asarray(point_cloud_range, dtype=np.float32)
+        xyz_coords = np.floor((points[:, :3] - pc_range[:3]) / voxel_size).astype(np.int32)
+        grid_size = np.floor((pc_range[3:6] - pc_range[:3]) / voxel_size).astype(np.int32)
+        valid = np.all((xyz_coords >= 0) & (xyz_coords < grid_size), axis=1)
+
+        voxels = np.zeros((max_voxels, max_points, points.shape[1]), dtype=points.dtype)
+        coordinates = np.zeros((max_voxels, 3), dtype=np.int32)
+        num_points = np.zeros(max_voxels, dtype=np.int32)
+        coord_to_index = {}
+        voxel_count = 0
+
+        for point, coord_xyz in zip(points[valid], xyz_coords[valid]):
+            coord_zyx = tuple(coord_xyz[::-1])
+            voxel_idx = coord_to_index.get(coord_zyx)
+            if voxel_idx is None:
+                if voxel_count >= max_voxels:
+                    continue
+                voxel_idx = voxel_count
+                coord_to_index[coord_zyx] = voxel_idx
+                coordinates[voxel_idx] = coord_zyx
+                voxel_count += 1
+            point_idx = num_points[voxel_idx]
+            if point_idx < max_points:
+                voxels[voxel_idx, point_idx] = point
+                num_points[voxel_idx] += 1
+
+        return voxels[:voxel_count], coordinates[:voxel_count], num_points[:voxel_count]
